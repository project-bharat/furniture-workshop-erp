# Copy this file to .env before running docker compose.
# Replace every placeholder with a unique secret; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_SECRET=replace-with-a-separate-one-time-bootstrap-secret

# Set this in the web-admin deployment environment, not in the browser.
WORKSHOP_API_URL=https://your-api-domain.example/api/v1
